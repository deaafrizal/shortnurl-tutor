# Application Configuration
APP_NAME=DEASHORTN
APP_ENV=production
APP_DEBUG=false

# Database Configuration (REQUIRED - must be set)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=shortnurl
DB_USERNAME=shortnurl
DB_PASSWORD=your_strong_db_password_here

# Application Configuration
BASE_URL=http://localhost

# SECURITY NOTICE:
# 1. Never commit .env with real credentials
# 2. Always use strong, unique passwords in production
# 3. Keep .env file outside of web root
# 4. Set proper file permissions: chmod 600 .env
# 5. All database variables (DB_*) are REQUIRED
